{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://host.docker.internal:11434/v1",
        "websearch_cited": {
          "model": "qwen3-coder:30b-16k"
        }
      },
      "models": {
        "qwen3-coder:30b-16k": {
          "tools": true
        }
      }
    }
  },
  "plugin": [
  ],
  "mcp": {
    "searxng": {
      "type": "local",
      "command": ["npx", "-y", "mcp-searxng"],
      "enabled": true,
      "environment": {
        "SEARXNG_URL": "http://host.docker.internal:2002"
      }
    }
  }
}